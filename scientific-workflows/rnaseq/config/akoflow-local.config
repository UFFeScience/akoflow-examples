process.executor = "local"
executor.queueSize = 2
conda.enabled = true
conda.useMicromamba = true
docker.enabled = false
singularity.enabled = false
process {
  withName: '.*' { cpus = 2; memory = 4.GB; time = 8.h; errorStrategy = 'terminate'; maxRetries = 0 }
  withName: '.*:CAT_FASTQ' { conda = '/opt/nf-envs/cat-fastq' }
  withName: '.*:CUSTOM_GTFFILTER' { conda = '/opt/nf-envs/custom-gtffilter' }
  withName: '.*:CUSTOM_TX2GENE' { conda = '/opt/nf-envs/custom-tx2gene' }
  withName: '.*:EAUTILS_GTF2BED' { conda = '/opt/nf-envs/ea-utils-gtf2bed' }
  withName: '.*:FASTP' { conda = '/opt/nf-envs/fastp' }
  withName: '.*:FASTQC' { conda = '/opt/nf-envs/fastqc' }
  withName: '.*:FASTQC_FILTERED' { conda = '/opt/nf-envs/fastqc' }
  withName: '.*:FASTQC_RAW' { conda = '/opt/nf-envs/fastqc' }
  withName: '.*:FASTQC_TRIM' { conda = '/opt/nf-envs/fastqc' }
  withName: '.*:FQ_LINT' { conda = '/opt/nf-envs/fq-lint' }
  withName: '.*:FQ_LINT_AFTER_BBSPLIT' { conda = '/opt/nf-envs/fq-lint' }
  withName: '.*:FQ_LINT_AFTER_RIBO_REMOVAL' { conda = '/opt/nf-envs/fq-lint' }
  withName: '.*:FQ_LINT_AFTER_TRIMMING' { conda = '/opt/nf-envs/fq-lint' }
  withName: '.*:FQ_SUBSAMPLE' { conda = '/opt/nf-envs/fq-subsample' }
  withName: '.*:GFFREAD' { conda = '/opt/nf-envs/gffread' }
  withName: '.*:GFFREAD_GENE_BED' { conda = '/opt/nf-envs/gffread' }
  withName: '.*:GFFREAD_TRANSCRIPTS' { conda = '/opt/nf-envs/gffread' }
  withName: '.*:GUNZIP' { conda = '/opt/nf-envs/gunzip' }
  withName: '.*:GUNZIP_ADDITIONAL_FASTA' { conda = '/opt/nf-envs/gunzip' }
  withName: '.*:GUNZIP_FASTA' { conda = '/opt/nf-envs/gunzip' }
  withName: '.*:GUNZIP_GENE_BED' { conda = '/opt/nf-envs/gunzip' }
  withName: '.*:GUNZIP_GFF' { conda = '/opt/nf-envs/gunzip' }
  withName: '.*:GUNZIP_GTF' { conda = '/opt/nf-envs/gunzip' }
  withName: '.*:GUNZIP_RRNA_FASTAS' { conda = '/opt/nf-envs/gunzip' }
  withName: '.*:GUNZIP_TRANSCRIPT_FASTA' { conda = '/opt/nf-envs/gunzip' }
  withName: '.*:MULTIQC' { conda = '/opt/nf-envs/multiqc' }
  withName: '.*:SALMON_INDEX' { conda = '/opt/nf-envs/salmon-index' }
  withName: '.*:SALMON_QUANT' { conda = '/opt/nf-envs/salmon-quant' }
  withName: '.*:SAMTOOLS_FAIDX' { conda = '/opt/nf-envs/samtools-faidx' }
  withName: '.*:TRIMGALORE' { conda = '/opt/nf-envs/trimgalore' }
  withName: '.*:TXIMETA_TXIMPORT' { conda = '/opt/nf-envs/tximeta-tximport' }
}
