{
  "scientific-ai/ai-assisted-analysis": {
    "module": "scientific/ai_assisted_analysis",
    "summary": "Integrate a first-order decay equation, compare numerical measurements with the analytic solution, independently infer the decay rate using log-linear regression, and validate both branches before publishing a report. The smoke profile uses a small numerical experiment and a fitted regression model; it does not call a hosted LLM.",
    "inputs": {
      "initial": 10,
      "decay": 0.3,
      "step": 0.05,
      "steps": 80,
      "maxError": 0.04
    }
  },
  "scientific-ai/surrogate-model": {
    "module": "scientific/surrogate_model",
    "summary": "Evaluate a damped-response integral in two independent simulation shards, assemble the samples, fit a piecewise-linear surrogate, and validate it against held-out numerical evaluations. All computation runs locally on the CPU.",
    "inputs": {
      "samples": 32,
      "minimum": 0.1,
      "maximum": 3,
      "integrationSteps": 300,
      "maxError": 0.001
    }
  },
  "scientific-ai/experiment-feedback-loop": {
    "module": "scientific/experiment_feedback_loop",
    "summary": "Fit a quadratic response model from local observations, propose a new experiment batch, enforce parameter limits, execute the proposed experiments, and verify that the measured optimum improves on the original observations. This is a numerical closed loop, not a hardware experiment.",
    "inputs": {
      "observations": [
        0,
        0.5,
        1,
        3,
        4
      ],
      "optimum": 2.2,
      "offset": 10,
      "minimum": 0,
      "maximum": 4
    }
  },
