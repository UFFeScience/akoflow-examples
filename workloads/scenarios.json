        {
          "id": "mlflow",
          "text": "MLflow records experiment parameters and metrics. A local SQLite tracking store preserves model run evidence."
        },
        {
          "id": "montage",
          "text": "Montage creates astronomical image mosaics from FITS observations. Projection and background correction precede the final mosaic."
        }
      ],
      "questions": [
        {
          "question": "What creates astronomical mosaics?",
          "document": "montage",
          "contains": "Montage creates"
        },
