  "generative-ai/rag-indexing": {
    "module": "generative/rag_indexing",
    "summary": "Clean and chunk a bundled document corpus, compute normalized TF-IDF vectors, build a portable JSON search index, and run retrieval and extractive-answer checks in parallel. This CPU profile uses lexical embeddings and source quotations, not a hosted embedding model or a generative LLM.",
    "inputs": {
      "documents": [
        {
          "id": "akoflow",
          "text": "Akoflow schedules activities using a directed acyclic graph. Each activity publishes artifacts for downstream dependencies."
